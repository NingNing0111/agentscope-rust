{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentscope-rust/schemas/capability-matrix.schema.json",
  "title": "Capability Matrix",
  "description": "Schema for capability compatibility matrix",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/MatrixEntry" },
      "minItems": 1
    }
  },
  "$defs": {
    "MatrixEntry": {
      "type": "object",
      "required": [
        "capability_id", "category", "upstream_symbol",
        "source_location", "description", "dependencies",
        "priority", "target_level", "status"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "category": { "type": "string" },
        "upstream_symbol": { "type": "string" },
        "source_location": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priority": {
          "type": "string",
          "enum": [
            "MVP_REQUIRED", "CORE_REQUIRED", "ADVANCED",
            "DEFERRED", "INTENTIONALLY_UNSUPPORTED"
          ]
        },
        "target_level": {
          "type": "string",
          "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]
        },
        "status": {
          "type": "string",
          "enum": [
            "NOT_ANALYZED", "ANALYZING", "SPECIFIED",
            "IMPLEMENTING", "PARTIAL", "COMPATIBLE",
            "DEFERRED", "UNSUPPORTED", "BLOCKED"
          ]
        },
        "test_fixture_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
